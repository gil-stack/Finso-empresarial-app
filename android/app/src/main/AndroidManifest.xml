<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- La notificación en vivo de cada SPEI (§11). Se pide al ver el primer resultado. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 16: que salga como Live Update (chip en la barra de estado). -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />

    <!-- Sin respaldo en la nube: la llave, los tokens y la empresa elegida
         nunca salen del teléfono (especificación §2). -->
    <application
        android:name=".FinsoApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/sin_respaldo"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_nombre"
        android:supportsRtl="false"
        android:localeConfig="@xml/idiomas"
        android:networkSecurityConfig="@xml/red"
        android:theme="@style/Tema.Finso.Arranque"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Tema.Finso.Arranque">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Ligas internas: notificación, widget y accesos directos. Sin
                 BROWSABLE, así ninguna página web puede abrirlas. Solo dicen a
                 dónde ir; todo se vuelve a pedir al servidor con la sesión. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="finso-empresarial" />
            </intent-filter>
        </activity>

        <!-- FCM: Firebase se arranca a mano (sistema/AvisosPush.kt), no al abrir la app. -->
        <provider
            android:name="com.google.firebase.provider.FirebaseInitProvider"
            android:authorities="${applicationId}.firebaseinitprovider"
            tools:node="remove" />
        <meta-data
            android:name="firebase_messaging_auto_init_enabled"
            android:value="false" />

        <service
            android:name=".sistema.MensajesFinso"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <receiver
            android:name=".sistema.ReceptorDeAvisos"
            android:exported="false" />

        <receiver
            android:name=".sistema.WidgetFinso"
            android:exported="false"
            android:label="@string/app_nombre">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_finso" />
        </receiver>
    </application>
</manifest>
