<?xml version="1.0" encoding="utf-8"?>
<!-- Solo HTTPS y solo con los certificados del sistema (no los que instale el usuario). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
